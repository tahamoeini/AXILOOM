{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiloom.dev/schemas/config-profile.v4.json",
  "title": "Axiloom configuration profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "organization", "sourceInstance", "projects", "projectRoles", "teams", "boardRoutes", "fieldMappings", "workflows", "calendar", "modules", "recordTemplates"],
  "$defs": {
    "workflow": {
      "type": "object",
      "properties": {
        "backlogStatuses": { "$ref": "#/$defs/statusNames" },
        "readyStatuses": { "$ref": "#/$defs/statusNames" },
        "startedStatuses": { "$ref": "#/$defs/statusNames" },
        "blockedStatuses": { "$ref": "#/$defs/statusNames" },
        "reviewStatuses": { "$ref": "#/$defs/statusNames" },
        "entryStatuses": { "$ref": "#/$defs/statusNames" },
        "completedStatuses": { "$ref": "#/$defs/statusNames" },
        "cancelledStatuses": { "$ref": "#/$defs/statusNames" },
        "completionStatusCategories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 80 } },
        "resolutionCompletes": { "type": "boolean" },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "statuses"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "statuses": { "$ref": "#/$defs/statusNames" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "statusNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 160 } },
    "workInterval": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "end": { "type": "string", "pattern": "^(?:([01]\\d|2[0-3]):[0-5]\\d|24:00)$" },
        "weekdays": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 6 } }
      },
      "additionalProperties": false
    },
    "recordField": {
      "type": "object",
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "enum": ["text", "textarea", "date", "enum", "recordRef", "issueRef", "issueRefList", "number", "boolean"] },
        "required": { "type": "boolean" },
        "options": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "maxLength": 160 } },
        "referenceKinds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" } }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] }, "then": { "properties": { "options": { "minItems": 1 } } } },
        { "if": { "properties": { "type": { "const": "recordRef" } }, "required": ["type"] }, "then": { "properties": { "referenceKinds": { "minItems": 1 } } } }
      ]
    },
    "recordTemplate": {
      "type": "object",
      "required": ["kind", "label", "group", "enabled", "fields"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "group": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" },
        "enabled": { "type": "boolean" },
        "fields": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/recordField" } }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": { "const": 4 },
    "configurationRevision": { "type": "integer", "minimum": 0 },
    "organization": {
      "type": "object",
      "required": ["name", "locale", "timeZone"],
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "locale": { "type": "string", "maxLength": 40 },
        "timeZone": { "type": "string", "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "workspaceName": { "type": "string", "maxLength": 200 },
    "sourceInstance": {
      "type": "object",
      "required": ["id", "provider", "displayName", "endpoint", "networkAccess"],
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "provider": { "enum": ["offline-json", "jira-datacenter"] },
        "displayName": { "type": "string", "maxLength": 160 },
        "endpoint": { "type": "string", "maxLength": 2000 },
        "networkAccess": {
          "type": "object",
          "required": ["mode", "approvedAddresses"],
          "properties": {
            "mode": { "enum": ["private", "public-pinned"] },
            "approvedAddresses": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "type": "string", "format": "ipv4" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "jiraUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "projects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 80 } },
    "projectRoles": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "aliases"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "aliases": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
          "parentTeamId": { "type": "string", "maxLength": 80 },
          "activeFrom": { "type": "string", "maxLength": 10 },
          "activeTo": { "type": "string", "maxLength": 10 }
        },
        "additionalProperties": false
      }
    },
    "boardRoutes": { "type": "array", "items": { "type": "object", "required": ["boardId", "teamId"], "properties": { "boardId": { "type": "string", "pattern": "^\\d+$" }, "teamId": { "type": "string" }, "team": { "type": "string" }, "activeFrom": { "type": "string", "maxLength": 10 }, "activeTo": { "type": "string", "maxLength": 10 } }, "additionalProperties": false } },
    "teamAssignments": {
      "type": "object",
      "properties": {
        "projects": { "type": "array", "items": { "type": "object", "required": ["projectKey", "teamId"], "properties": { "projectKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "teamId": { "type": "string" }, "activeFrom": { "type": "string", "maxLength": 10 }, "activeTo": { "type": "string", "maxLength": 10 } }, "additionalProperties": false } },
        "components": { "type": "array", "items": { "type": "object", "required": ["projectKey", "teamId"], "properties": { "projectKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "componentId": { "type": "string" }, "componentName": { "type": "string" }, "teamId": { "type": "string" }, "activeFrom": { "type": "string", "maxLength": 10 }, "activeTo": { "type": "string", "maxLength": 10 } }, "additionalProperties": false } },
        "issueOverrides": { "type": "array", "items": { "type": "object", "required": ["issueKey", "teamId"], "properties": { "issueKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*-\\d+$" }, "teamId": { "type": "string" }, "activeFrom": { "type": "string", "maxLength": 10 }, "activeTo": { "type": "string", "maxLength": 10 } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "fieldMappings": { "type": "array", "items": { "type": "object", "required": ["semanticKey", "providerFieldId"], "properties": { "semanticKey": { "type": "string" }, "providerFieldId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$" }, "providerFieldName": { "type": "string", "maxLength": 200 }, "projectKey": { "type": "string" }, "issueTypeId": { "type": "string" }, "transform": { "enum": ["identity", "number", "text", "option-label", "id-list", "boolean"] } }, "additionalProperties": false } },
    "workflows": {
      "type": "object",
      "properties": {
        "delivery": { "$ref": "#/$defs/workflow" },
        "intake": { "$ref": "#/$defs/workflow" },
        "commitment": { "$ref": "#/$defs/workflow" }
      },
      "additionalProperties": false
    },
    "calendar": { "type": "object", "required": ["configured", "timeZone", "workingDays", "hoursPerDay", "holidays"], "properties": { "configured": { "type": "boolean" }, "timeZone": { "type": "string" }, "workingDays": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 6 } }, "hoursPerDay": { "type": "number", "exclusiveMinimum": 0, "maximum": 24 }, "holidays": { "type": "array", "items": { "type": "string", "format": "date" } }, "workIntervals": { "type": "array", "items": { "$ref": "#/$defs/workInterval" } } }, "additionalProperties": false },
    "capacityOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["teamId", "sprintId", "assigneeKey", "assignee", "activeFrom", "activeTo", "overrideWorkingDays", "allocation"],
        "properties": {
          "teamId": { "type": "string", "maxLength": 80 },
          "sprintId": { "type": "string", "maxLength": 80 },
          "assigneeKey": { "type": "string", "maxLength": 160 },
          "assignee": { "type": "string", "maxLength": 200 },
          "activeFrom": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
          "activeTo": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
          "overrideWorkingDays": { "type": ["number", "null"], "minimum": 0, "maximum": 366 },
          "allocation": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "modules": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "recordTemplates": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/recordTemplate" } }
  }
}
